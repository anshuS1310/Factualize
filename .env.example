# =============================================================================
# Factualize - Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env       (Linux / macOS)
#    Copy-Item .env.example .env (Windows PowerShell)
# 2. Fill in your Gemini API key below.
# 3. DO NOT commit .env to version control. .env is ignored by .gitignore.
# =============================================================================

# Your Google Gemini API Key (Get one from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Models
# Extraction model: Fast model for page & table fact extraction (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash

# Reasoning model: Optional. Used for cross-document relationship reasoning.
# If left blank, the extraction model is used.
GEMINI_REASONING_MODEL=gemini-3.5-flash

# Local Storage & Upload Limits
FACTUALIZE_DATA_DIR=data
FACTUALIZE_MAX_UPLOAD_MB=100
FACTUALIZE_MAX_PAGES=1000

# Rate Limiting & Retry Policies
FACTUALIZE_GEMINI_MIN_INTERVAL_SECONDS=4
FACTUALIZE_GEMINI_MAX_AUTOMATIC_ATTEMPTS=2
FACTUALIZE_GEMINI_MAX_MANUAL_ATTEMPTS=1

# Candidate & Reasoning Budgets
FACTUALIZE_ENTITY_MERGE_CANDIDATE_BUDGET=100
FACTUALIZE_RELATIONSHIP_GEMINI_CALL_BUDGET=8
